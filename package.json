{
  "name": "@lolkda/dsh-file-manager",
  "version": "0.1.4",
  "description": "Independent DSH file manager with explicit Host-local root grants",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "file-manager"
  ],
  "homepage": "https://github.com/lolkda/dsh-file-manager#readme",
  "bugs": {
    "url": "https://github.com/lolkda/dsh-file-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolkda/dsh-file-manager.git"
  },
  "license": "UNLICENSED",
  "author": "lolkda",
  "type": "module",
  "engines": { "node": ">=24" },
  "os": ["linux"],
  "cpu": ["x64"],
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "host", "contracts", "tests", "cordis.patch.yml", "README.md", "SPEC.md"],
  "scripts": {
    "build:native": "cc -O2 -Wall -Wextra -Werror -std=c17 host/native/rename-no-replace.c -o host/native/rename-no-replace",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check host/manager.js && node --check host/io.js && node --check host/tasks.js && node --check host/transfers.js && node --check host/state.js && node --check host/watch.js && node --check host/requests.js && node --check host/atomic-rename.js && node --check host/line-endings.js",
    "prepublishOnly": "npm run check && npm run build:native && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "diff": "^8.0.0",
    "yazl": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "yauzl": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"],
      "external": ["@deepseek-ai/dsh-client-ui-primitives"]
    }
  }
}