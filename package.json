{
  "name": "@lolkda/dsh-file-manager",
  "version": "0.2.8",
  "description": "Independent DSH file manager with explicit Host-local root grants",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "file-manager"
  ],
  "homepage": "https://github.com/lolkda/dsh-file-manager#readme",
  "bugs": {
    "url": "https://github.com/lolkda/dsh-file-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolkda/dsh-file-manager.git"
  },
  "license": "UNLICENSED",
  "author": "lolkda",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "host",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.host.json --noEmit --declaration false --declarationMap false --sourceMap false && tsc -p tsconfig.client.json",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "build:native": "cc -O2 -Wall -Wextra -Werror -std=c17 host/native/rename-no-replace.c -o host/native/rename-no-replace",
    "pretest": "node scripts/require-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm run check:dist",
    "prepublishOnly": "npm run check && npm run build:native && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "diff": "^8.0.0",
    "yazl": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^7.0.2",
    "yauzl": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
